# Источник данных по умолчанию: "yadisk" или "local"
DATA_SOURCE="local"

# --- Креды для работы с Яндекс.Диском ---
YANDEX_TOKEN="ваш_oauth_токен"
DISK_PATH="/путь/к/файлу.xlsx"

# --- Путь к файлу на локальном ПК ---
LOCAL_FILE_PATH="C:\\path\\to\\registry.xlsx"

# Папка с картинками товаров (фото и QR-коды).
# Если не задана — используется "images" рядом с проектом.
IMAGES_DIR="C:\\path\\to\\images"

# Базовый URL Google Forms для QR-кодов товаров
QR_FORM_URL="https://docs.google.com/forms/d/e/.../viewform?usp=pp_url&entry.XXXXXXX="